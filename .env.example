# Non-secret defaults for local development and CI
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETA_COPY_ENABLED=1

SUPABASE_URL=http://localhost
SUPABASE_ANON_KEY=test
# Backwards compatibility
SUPABASE_KEY=test

# Provider: 'sportsdata' | 'thesportsdb'
SPORTS_API_PROVIDER=thesportsdb

# Shared logical key (works for both providers)
SPORTS_API_KEY=dummy # Tests use MSW; no real key required.

# Only for TheSportsDB
THESPORTSDB_API_VERSION=1

